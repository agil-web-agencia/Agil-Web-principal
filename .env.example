# GEMINI_API_KEY: Requerida para las llamadas a la API de Gemini AI.
# En producción con Cloudflare Pages, configura esta clave en:
# Dashboard de Cloudflare -> Pages -> Tu Proyecto -> Settings -> Environment Variables.
# En desarrollo local, puedes agregar tu clave aquí en un archivo .env local.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL donde se aloja la aplicación.
APP_URL="MY_APP_URL"
